# ==========================================
# AdMetrics & Growth AI - Environment Configuration
# ==========================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase (Auth, PostgreSQL, Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Provider Configuration (Google Gemini / OpenAI / Anthropic)
AI_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Meta Marketing API (OAuth & Webhooks)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_REDIRECT_URI="http://localhost:3000/api/auth/meta/callback"

# Google Ads API (OAuth & Developer Token)
GOOGLE_ADS_CLIENT_ID="your-google-client-id"
GOOGLE_ADS_CLIENT_SECRET="your-google-client-secret"
GOOGLE_ADS_DEVELOPER_TOKEN="your-developer-token"
GOOGLE_ADS_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Encryption Secret for Storing OAuth Tokens at rest
TOKEN_ENCRYPTION_SECRET="super-secret-32-byte-hex-string-for-aes256"

# Worker / Background Jobs
WORKER_CONCURRENCY=5
SYNC_CRON_INTERVAL="0 * * * *"
